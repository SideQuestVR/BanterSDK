<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <!-- Styled by BuilderWindow.uss, which BuilderWindow.cs adds, in the Setup panel's look: editor theme colours,
         bordered cards and one pink primary action. BuilderWindow.cs, LoginManager.cs, TabsManager.cs, Status.cs and
         BuildChecklistView.cs find the named elements here by name and type, and show or hide several of them. -->
    <ui:VisualElement name="BuilderRoot" class="builder">
        <ui:VisualElement class="builder__header">
            <ui:VisualElement class="builder__logo" />
            <ui:VisualElement class="builder__titles">
                <ui:Label text="Builder" class="builder__title" />
                <ui:Label text="" name="BuilderVersion" class="builder__version" />
            </ui:VisualElement>
            <ui:VisualElement class="builder__account">
                <ui:Button text="Sign in" name="OpenLink" tooltip="Opens the SideQuest link page with your code already filled in." class="builder__primary-button" />
                <ui:Label text="Fetching code..." name="LoginCode" class="builder__code" />
                <ui:VisualElement name="LoggedInView" class="builder__signed-in" style="display: none;">
                    <ui:Label text="Hi there!" name="SignedInStatus" class="alt-account" />
                    <ui:Label text="Sign out" name="SignOut" class="alt-link builder__sign-out" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="Drop in your scene, pick the world it goes to, then build and publish your world." class="builder__intro" />
        <!-- Single-section layout for now: Avatar is hidden and Logs moved to the
             bottom of SpaceSection, so there is nothing left to navigate between.
             Set display back to flex (and AvatarSection/LogsSection likewise, plus
             restore the saved-tab block in TabsManager.cs) to bring tabs back. -->
        <ui:VisualElement name="Nav" style="height: 80px; min-height: 80px; display: none;">
            <ui:VisualElement name="Tabs" style="flex-direction: row; justify-content: space-around; margin-left: 5%; margin-right: 5%; margin-top: 0; margin-bottom: 0; border-bottom-width: 1px; border-bottom-color: rgba(128, 128, 128, 0.3);">
                <ui:Label text="Space" display-tooltip-when-elided="true" name="SpaceTab" class="alt-tab-label">
                    <ui:VisualElement class="alt-tab-icon" style="background-image: resource(&apos;UI/Images/icon-worlds&apos;);" />
                </ui:Label>
                <ui:Label text="Avatar" display-tooltip-when-elided="true" name="AvatarTab" class="alt-tab-label">
                    <ui:VisualElement class="alt-tab-icon" style="background-image: resource(&apos;UI/Images/icon-avatar&apos;);" />
                </ui:Label>
                <ui:Label text="Logs" display-tooltip-when-elided="true" name="LogsTab" class="alt-tab-label">
                    <ui:VisualElement class="alt-tab-icon" style="background-image: resource(&apos;UI/Images/icon-logs&apos;);" />
                </ui:Label>
            </ui:VisualElement>
            <ui:VisualElement name="ActiveTab" style="background-color: rgb(186, 38, 98); height: 3px; width: 90px; transition-timing-function: ease-out-back; transition-duration: 0.5s; transition-property: left; left: 80px; position: relative; margin-top: 0; top: -2px;" />
        </ui:VisualElement>
        <ui:VisualElement name="TabSections" class="builder__sections" style="width: 400%; min-width: 400%; flex-direction: row; transition-timing-function: ease-out-back; transition-duration: 0.5s; transition-property: left; left: 0;">
            <ui:VisualElement name="SpaceSection" style="width: 25%;">
                <ui:ScrollView horizontal-scroller-visibility="Hidden" class="builder__scroll">
                    <ui:VisualElement class="builder__content">
                        <ui:VisualElement name="dropAreaContainer" class="builder__drop-container">
                            <ui:VisualElement name="dropArea" tooltip="Drop a .unity scene file here to build the space bundle." class="builder__drop">
                                <ui:VisualElement picking-mode="Ignore" class="builder__drop-icon" />
                                <ui:Label picking-mode="Ignore" text="Drop a scene here to start" class="builder__drop-title" />
                                <ui:Label picking-mode="Ignore" text="Drag a .unity scene file in from the Project window." class="builder__drop-hint" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <!-- Hidden and shown as one with the scene: the Reset button lives inside this label. -->
                        <ui:Label tabindex="-1" text="Scene" name="MainTitle" class="builder__section builder__section--with-button">
                            <ui:Button text="Reset" name="resetScreen" tooltip="Forget this scene so you can drop in another one." class="builder__small-button" />
                        </ui:Label>
                        <ui:VisualElement name="scenePathParent" class="builder__row">
                            <ui:Label name="scenePathLabel" text="Scene: Assets/Scenes/MyWorld.unity" class="builder__value" />
                        </ui:VisualElement>
                        <ui:VisualElement name="sceneStatsParent" class="builder__row" style="display: none;">
                            <ui:Label name="sceneStatsLabel" text="" class="builder__value alt-muted" />
                        </ui:VisualElement>
                        <ui:VisualElement name="LoggedInViewScene" class="builder__world">
                            <ui:Label tabindex="-1" text="World" class="builder__section" />
                            <ui:DropdownField name="WorldDropdown" class="builder__dropdown" />
                            <ui:Label text="" name="WorldUrl" class="builder__value alt-muted builder__world-url" />
                            <ui:VisualElement class="builder__inline">
                                <ui:Label text="Don&apos;t have a world yet?" class="builder__value alt-muted" />
                                <ui:Label text="Create one" name="CreateSpace" class="alt-link builder__inline-link" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="BuildOptions">
                            <ui:Toggle label="Upload after building" value="true" name="autoUpload" class="alt-toggle" style="display: none;" />
                        </ui:VisualElement>
                        <ui:VisualElement name="LoggedInCTAScene" class="builder__actions">
                            <ui:VisualElement class="alt-pill builder__build">
                                <ui:Label text="Build" name="buildButton" class="alt-pill-label" />
                            </ui:VisualElement>
                            <ui:VisualElement name="ExtraUploadButtons" class="builder__button-row">
                                <ui:Button text="Upload HTML + JS" name="UploadWebOnly" tooltip="Uploads only the web files from Assets/WebRoot: quick script changes without rebuilding." />
                                <ui:Button text="Upload all" name="UploadEverything" tooltip="Uploads the built asset.world and the web files." />
                            </ui:VisualElement>
                            <ui:VisualElement name="ExtraToolButtons" class="builder__button-row">
                                <ui:Button text="WebRoot folder" name="OpenWebRoot" tooltip="Shows Assets/WebRoot, where builds go, in the Project window." />
                                <ui:Button text="Analyze bundle" name="AnalyzeBundle" tooltip="Preview the AssetBundle contents and estimated size of the currently open scene using Bundle Analyzer." />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="ChecklistSection" class="builder__checklist" />
                        <ui:VisualElement class="builder__section-row">
                            <ui:Label tabindex="-1" text="Logs" class="builder__section builder__section--inline" />
                            <ui:VisualElement class="builder__spacer" />
                            <ui:Button text="Clear logs" name="clearLogs" class="builder__small-button" />
                        </ui:VisualElement>
                        <ui:ListView focusable="false" name="buildProgress" class="builder__logs" />
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="AvatarSection" style="display: none; width: 25%;">
                <ui:ScrollView horizontal-scroller-visibility="Hidden">
                    <ui:VisualElement name="dropAvatarContainer" style="flex-grow: 1; display: flex;">
                        <ui:VisualElement style="position: absolute; background-image: resource(&apos;UI/Images/CapsuleMan_2D&apos;); width: 93px; height: 93px; left: 50%; margin-left: -46.5px;" />
                        <ui:VisualElement name="dropAvatarArea" tooltip="Drop a GameObject here that is the root of your avatar. " style="background-image: resource(&apos;UI/Images/Frame 3&apos;); width: auto; height: auto; -unity-slice-left: 48; -unity-slice-top: 48; -unity-slice-right: 48; -unity-slice-bottom: 48; -unity-slice-scale: 0.5; margin-top: 60px; margin-left: 5%; margin-right: 5%; flex-shrink: 0; flex-grow: 0; margin-bottom: 20px;">
                            <ui:Label text="Drop an avatar GameObject &#10;from the hierarchy to start." display-tooltip-when-elided="true" class="unity-label-margin" style="-unity-text-align: middle-center; height: auto; justify-content: flex-start; align-items: auto; font-size: 14px; margin-top: 45px; margin-bottom: 45px; white-space: normal;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="AvatarInfoCard" style="flex-grow: 1; display: flex;">
                        <ui:Label tabindex="-1" text="Avatar Build" parse-escape-sequences="true" display-tooltip-when-elided="true" name="MainTitleAvatar" style="font-size: 18px; -unity-text-align: upper-left; padding-left: 30px; align-items: flex-end;">
                            <ui:Button text="Reset" parse-escape-sequences="true" display-tooltip-when-elided="true" name="resetAvatarScreen" class="" style="margin-top: 0; margin-bottom: 10px; margin-right: 30px;" />
                        </ui:Label>
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row; justify-content: flex-start; align-items: stretch;">
                            <ui:VisualElement style="flex-grow: 0;">
                                <ui:Label tabindex="-1" text="Selected Avatar" parse-escape-sequences="true" display-tooltip-when-elided="true" style="padding-left: 30px; margin-bottom: 0;" />
                                <ui:Label tabindex="-1" text="GameObject3" parse-escape-sequences="true" display-tooltip-when-elided="true" name="SelectAvatar" class="alt-muted" style="padding-left: 30px; margin-bottom: 10px;" />
                            </ui:VisualElement>
                            <ui:Button text="Show" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ShowAvatar" style="margin-top: 0;" />
                        </ui:VisualElement>
                        <ui:VisualElement name="HeadObjectList" style="flex-grow: 1; flex-direction: column; justify-content: space-between; padding-right: 30px; padding-bottom: 10px; padding-left: 30px;" />
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row; justify-content: space-between; padding-right: 30px; padding-bottom: 10px;">
                            <ui:VisualElement style="flex-grow: 1;">
                                <ui:Label tabindex="-1" text="Center Eye Position" parse-escape-sequences="true" display-tooltip-when-elided="true" style="margin-left: 30px; margin-top: 10px;" />
                                <ui:Label tabindex="-1" text="Not Selected" parse-escape-sequences="true" display-tooltip-when-elided="true" name="CenterEyePoseLabel" class="alt-muted" style="margin-left: 30px; margin-top: 10px;" />
                                <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                                    <ui:Button text="Reset Position" display-tooltip-when-elided="true" name="CenterEyePosReset" class="alt-avatar-small" style="margin-left: 30px; max-width: 100px; display: none;" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:Button text="Change" display-tooltip-when-elided="true" name="SelectCenterEye" style="margin-top: 10px; margin-bottom: 10px; margin-left: 0; margin-right: 0;" />
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row; justify-content: space-between; padding-right: 30px; padding-bottom: 10px;">
                            <ui:VisualElement style="flex-grow: 1;">
                                <ui:Label tabindex="-1" text="Left Foot Ground Pose " parse-escape-sequences="true" display-tooltip-when-elided="true" style="margin-left: 30px; margin-top: 10px;" />
                                <ui:Label tabindex="-1" text="Not Selected" parse-escape-sequences="true" display-tooltip-when-elided="true" name="LeftFootPoseLabel" class="alt-muted" style="margin-left: 30px; margin-top: 10px;" />
                                <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                                    <ui:Button text="Reset Pos" display-tooltip-when-elided="true" name="LeftFootPosReset" class="alt-avatar-small" style="margin-left: 30px; max-width: 80px; display: none;" />
                                    <ui:Button text="Reset Rot" display-tooltip-when-elided="true" name="LeftFootRotReset" class="alt-avatar-small" style="max-width: 80px; display: none;" />
                                    <ui:Button text="Reset Rot (World)" display-tooltip-when-elided="true" name="LeftFootRotWorldReset" class="alt-avatar-small" style="max-width: 120px; display: none;" />
                                </ui:VisualElement>
                                <ui:Button text="Mirror Right Pos" display-tooltip-when-elided="true" name="LeftFootMirror" class="alt-avatar-small" style="margin-left: 30px; max-width: 108px; display: none;" />
                            </ui:VisualElement>
                            <ui:Button text="Change" display-tooltip-when-elided="true" name="SelectLeftFoot" style="margin-top: 10px; margin-bottom: 10px; margin-left: 0; margin-right: 0;" />
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row; justify-content: space-between; padding-right: 30px; padding-bottom: 30px;">
                            <ui:VisualElement style="flex-grow: 1;">
                                <ui:Label tabindex="-1" text="Right Foot Ground Pose" parse-escape-sequences="true" display-tooltip-when-elided="true" style="margin-left: 30px; margin-top: 10px;" />
                                <ui:Label tabindex="-1" text="Not Selected" parse-escape-sequences="true" display-tooltip-when-elided="true" name="RightFootPoseLabel" class="alt-muted" style="margin-left: 30px; margin-top: 10px;" />
                                <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                                    <ui:Button text="Reset Pos" display-tooltip-when-elided="true" name="RightFootPosReset" class="alt-avatar-small" style="margin-left: 30px; max-width: 80px; display: none;" />
                                    <ui:Button text="Reset Rot" display-tooltip-when-elided="true" name="RightFootRotReset" class="alt-avatar-small" style="max-width: 80px; display: none;" />
                                    <ui:Button text="Reset Rot(World)" display-tooltip-when-elided="true" name="RightFootRotWorldReset" class="alt-avatar-small" style="max-width: 120px; display: none;" />
                                </ui:VisualElement>
                                <ui:Button text="Mirror Left Pos" display-tooltip-when-elided="true" name="RightFootMirror" class="alt-avatar-small" style="margin-left: 30px; max-width: 105px; display: none;" />
                            </ui:VisualElement>
                            <ui:Button text="Change" display-tooltip-when-elided="true" name="SelectRightFoot" style="margin-top: 10px; margin-bottom: 10px; margin-left: 0; margin-right: 0;" />
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row; justify-content: space-between; padding-right: 30px; padding-bottom: 30px;">
                            <ui:VisualElement style="flex-grow: 1;">
                                <ui:Label tabindex="-1" text="Create new Avatar or Upload to Existing" parse-escape-sequences="true" display-tooltip-when-elided="true" style="margin-left: 30px; margin-top: 10px; display: flex;" />
                                <ui:DropdownField name="ddlAvatarId" style="margin-left: 30px; display:flex;" />
                                <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                                    <ui:Toggle name="togAvatarIsPublic" style="height: 22px; margin-left: 30px;" />
                                    <ui:Label tabindex="-1" text="Avatar is Public (other users can clone)" parse-escape-sequences="true" display-tooltip-when-elided="true" style="margin-left: 10px; margin-top: 5px;" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="alt-pill" style="width: 215px; height: 32px; margin-left: 30px; margin-top: 0;">
                            <ui:Label text="Build &amp; upload" display-tooltip-when-elided="true" name="buildAvatarButton" class="alt-pill-label" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label tabindex="-1" parse-escape-sequences="true" display-tooltip-when-elided="true" name="MissingBones" class="alt-negative" style="-unity-font-style: normal; font-size: 12px; -unity-text-align: upper-left; padding-left: 30px; align-items: flex-end; padding-bottom: 10px; white-space: normal;" />
                </ui:ScrollView>
            </ui:VisualElement>
            <!-- Logs now live at the bottom of SpaceSection. This element is kept
                 (empty, hidden) because TabsManager.cs queries it by name. -->
            <ui:VisualElement name="LogsSection" style="display: none; width: 25%;" />
        </ui:VisualElement>
        <!-- Upload progress. Pinned above the status bar rather than living in the
             scroll view, so it stays on screen for the whole upload. -->
        <ui:ProgressBar title="Uploading..." name="buildProgressBar" class="builder__progress" style="display: none;" />
        <ui:Label text="Status: Idle" display-tooltip-when-elided="true" name="StatusBar" class="builder__status" />
    </ui:VisualElement>
    <ui:VisualElement name="BuildConfirm" class="builder__confirm" style="display: none;">
        <ui:VisualElement class="builder__confirm-card">
            <ui:Label tabindex="-1" text="Are you sure?" class="builder__confirm-title" />
            <ui:Label tabindex="-1" text="Check these details before you continue." name="Label" class="builder__value alt-muted" />
            <ui:VisualElement class="builder__confirm-details">
                <ui:Label tabindex="-1" text="Build Mode: " name="ConfirmBuildMode" class="builder__value" />
                <ui:Label tabindex="-1" text="Scene File: " name="ConfirmSceneFile" class="builder__value" />
                <ui:Label tabindex="-1" text="Space: " name="ConfirmSpaceCode" class="builder__value" />
                <ui:Label tabindex="-1" text="" name="ConfirmSyncedGraphs" class="builder__value alt-warning" style="display: none;" />
                <ui:VisualElement name="ConfirmChecklist" class="builder__confirm-checklist" style="display: none;" />
            </ui:VisualElement>
            <ui:VisualElement class="builder__confirm-buttons">
                <ui:Button text="Cancel" name="CancelBuild" />
                <ui:VisualElement class="alt-pill builder__confirm-pill">
                    <ui:Label text="Confirm" name="ConfirmBuild" class="alt-pill-label" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
