:root {
    padding-left: 25px;
    padding-right: 25px;
    padding-top: 16px;
    padding-bottom: 16px;
    background-image: url('project://database/Packages/com.sidequest.creator-sdk/Editor/Images/Main%20content.png?fileID=2800000&guid=40c599547cb1d0a4d94990b9692ca9f0&type=3#Main content');
    -unity-slice-left: 48;
    -unity-slice-top: 48;
    -unity-slice-right: 48;
    -unity-slice-bottom: 48;
    -unity-slice-scale: 0.25;
    margin-bottom: -12px;
}

.toggle-container {
    max-width: 300px;
    justify-content: space-between;
    align-items: center;
    flex-direction: row;
}

.unity-toggle.switch {
    justify-content: space-between;
    margin: 5px 12px;
}

.unity-toggle.switch .unity-label {
    font-size: 15px;
    color: rgb(153, 153, 153);
}

.unity-toggle.switch .unity-toggle__input {
    transition: all 0.6s;
    width: 40px;
    height: 20px;
    min-width: 40px;
    max-width: 40px;
    background-color: rgb(51, 51, 51);
    border-radius: 10px;
    padding: 0;
    margin: 0;
}

.unity-toggle.switch:checked .unity-toggle__input {
    background-color: rgb(41, 162, 166);
}

.unity-toggle.switch .unity-toggle__checkmark {
    transition: all 0.25s;
    width: 16px;
    max-width: 16px;
    min-width: 16px;
    height: 16px;
    margin: 2px;
    border-radius: 8px;
    background-color: white;
    background-image: none;
    translate: 0 0;
    transition-timing-function: ease-out;
}

.unity-toggle.switch:checked .unity-toggle__checkmark {
    translate: 20px 0;
}
