/* No background of its own: the inspector sits on Unity's own panel colour, so BS components
   look like every other component instead of a dark card inset in the window. */
:root {
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.toggle-container {
    max-width: 300px;
    justify-content: space-between;
    align-items: center;
    flex-direction: row;
}

.unity-toggle.switch {
    justify-content: space-between;
    margin: 5px 12px;
}

.unity-toggle.switch .unity-label {
    font-size: 15px;
    color: rgb(153, 153, 153);
}

.unity-toggle.switch .unity-toggle__input {
    transition: all 0.6s;
    width: 40px;
    height: 20px;
    min-width: 40px;
    max-width: 40px;
    background-color: rgb(51, 51, 51);
    border-radius: 10px;
    padding: 0;
    margin: 0;
}

.unity-toggle.switch:checked .unity-toggle__input {
    background-color: rgb(41, 162, 166);
}

.unity-toggle.switch .unity-toggle__checkmark {
    transition: all 0.25s;
    width: 16px;
    max-width: 16px;
    min-width: 16px;
    height: 16px;
    margin: 2px;
    border-radius: 8px;
    background-color: white;
    background-image: none;
    translate: 0 0;
    transition-timing-function: ease-out;
}

.unity-toggle.switch:checked .unity-toggle__checkmark {
    translate: 20px 0;
}
