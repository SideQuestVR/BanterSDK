.target-bar {
    flex-direction: row;
    align-items: center;
    min-height: 26px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.25);
}

.target-bar-label {
    margin-right: 6px;
    opacity: 0.8;
    -unity-text-align: middle-left;
}

.target-field {
    flex-grow: 1;
    flex-shrink: 0;
    min-height: 20px;
    max-width: 420px;
    margin-right: 16px;
}

.platform-dropdown {
    min-height: 20px;
    width: 140px;
}

.status-label {
    padding-left: 8px;
    padding-right: 8px;
    -unity-text-align: middle-left;
    opacity: 0.85;
}

.toolbar-spacer {
    flex-grow: 1;
}

.search-field {
    width: 220px;
    margin-right: 4px;
}

.cancel-button {
    margin-left: 4px;
    margin-right: 4px;
    display: none;
}

.load-progress-bar {
    width: 160px;
    margin-left: 4px;
    margin-right: 8px;
    align-self: center;
    display: none;
}

.empty-state-container {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.empty-state-label {
    font-size: 13px;
    -unity-font-style: italic;
    opacity: 0.6;
    -unity-text-align: middle-center;
    max-width: 380px;
    white-space: normal;
}

.main-content {
    flex-grow: 1;
    flex-direction: column;
    display: none;
}

.body-container {
    flex-grow: 1;
    flex-direction: row;
    min-height: 160px;
}

.list-view-container {
    flex-grow: 1;
    border-right-width: 1px;
    border-right-color: rgba(128, 128, 128, 0.2);
}

.panel-title {
    -unity-font-style: bold;
    margin-bottom: 6px;
    opacity: 0.85;
}

.pie-panel {
    width: 300px;
    padding: 10px;
    flex-direction: column;
}

.pie-imgui {
    flex-grow: 1;
    min-height: 200px;
}

.block-view-panel {
    height: 300px;
    flex-shrink: 0;
    flex-direction: column;
    padding: 10px;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.25);
}

.block-view-imgui {
    flex-grow: 1;
    min-height: 220px;
}

.hover-info-label {
    height: 18px;
    padding-right: 4px;
    padding-top: 2px;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.footer-label {
    padding-left: 8px;
    padding-right: 8px;
    padding-bottom: 5px;
    padding-top: 4px;
    opacity: 0.7;
    font-size: 11px;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.2);
}

.name-cell {
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
}

.name-cell-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    flex-shrink: 0;
}

.name-cell-label {
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}
