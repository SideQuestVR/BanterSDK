/* The Creator SDK Setup panel (SdkSetupWindow.cs). Colours come from the editor theme where they can, so
   it reads in both the dark and light skins; .sdk-setup--light adjusts the white icons for the light one. */

.sdk-setup {
    flex-grow: 1;
}

.sdk-setup__scroll {
    flex-grow: 1;
}

.sdk-setup__content {
    padding: 18px 20px 14px 20px;
}

/* -- Header ---------------------------------------------------------------- */

.sdk-setup__header-top {
    flex-direction: row;
    align-items: center;
}

.sdk-setup__logo {
    width: 40px;
    height: 40px;
    margin-right: 12px;
    flex-shrink: 0;
    background-image: resource('UI/Images/altspace-window-icon');
    -unity-background-scale-mode: scale-to-fit;
}

.sdk-setup--light .sdk-setup__logo {
    -unity-background-image-tint-color: rgb(40, 40, 40);
}

.sdk-setup__titles {
    flex-grow: 1;
    flex-shrink: 1;
}

.sdk-setup__title {
    font-size: 20px;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

.sdk-setup__version {
    padding: 0;
    margin-top: 2px;
    opacity: 0.65;
}

.sdk-setup__intro {
    white-space: normal;
    padding: 0;
    margin: 12px 0 16px 0;
    opacity: 0.85;
}

/* -- Builder / Documentation ------------------------------------------------- */

.sdk-setup__actions {
    flex-direction: row;
    margin-bottom: 22px;
}

.sdk-setup__action {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    min-height: 66px;
    margin: 0;
    padding: 12px 14px;
    border-radius: 6px;
    border-width: 1px;
    white-space: normal;
}

.sdk-setup__action--first {
    margin-right: 10px;
}

.sdk-setup__action--primary {
    background-color: rgb(186, 38, 98);
    border-color: rgb(214, 66, 126);
    color: rgb(255, 255, 255);
}

.sdk-setup__action--primary:hover {
    background-color: rgb(206, 50, 113);
}

.sdk-setup__action--primary:active {
    background-color: rgb(160, 30, 84);
}

.sdk-setup__action-icon {
    width: 28px;
    height: 28px;
    margin-right: 12px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.sdk-setup__action-icon--builder {
    background-image: resource('UI/Images/icon-worlds');
}

.sdk-setup__action-icon--docs {
    background-image: resource('UI/Images/icon-logs');
}

.sdk-setup--light .sdk-setup__action-icon {
    -unity-background-image-tint-color: rgb(40, 40, 40);
}

.sdk-setup--light .sdk-setup__action--primary .sdk-setup__action-icon {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.sdk-setup__action-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.sdk-setup__action-title {
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    padding: 0;
    margin: 0;
}

.sdk-setup__action-caption {
    font-size: 11px;
    white-space: normal;
    -unity-text-align: middle-left;
    padding: 0;
    margin-top: 3px;
    opacity: 0.8;
}

.sdk-setup__banner {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    margin-bottom: 10px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(230, 160, 40, 0.65);
    background-color: rgba(230, 160, 40, 0.16);
}

.sdk-setup__banner-text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    padding: 0;
}

.sdk-setup__banner-button {
    margin: 0 0 0 10px;
    flex-shrink: 0;
}

.sdk-setup__hint {
    font-size: 11px;
    white-space: normal;
    padding: 0;
    margin-top: 8px;
    opacity: 0.6;
}

/* -- Tools ------------------------------------------------------------------------ */

/* Uses the checklist's heading, list and row classes; a row ends in a button or this switch. */
.sdk-setup__tools {
    margin-top: 22px;
}

.sdk-setup__tool-toggle {
    flex-shrink: 0;
    align-self: center;
    margin: 0 0 0 10px;
}

/* -- Getting started ------------------------------------------------------------ */

.sdk-setup__getting-started {
    margin-top: 20px;
}

.sdk-setup__getting-started .unity-foldout__text {
    font-size: 15px;
    -unity-font-style: bold;
}

.sdk-setup__topic-title {
    -unity-font-style: bold;
    padding: 0;
    margin: 8px 0 3px 0;
}

.sdk-setup__bullet {
    flex-direction: row;
    margin-bottom: 3px;
}

.sdk-setup__bullet-mark {
    width: 12px;
    flex-shrink: 0;
    padding: 0;
    margin: 0;
    opacity: 0.6;
}

.sdk-setup__bullet-text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    padding: 0;
    margin: 0;
    opacity: 0.85;
}

/* -- Footer ------------------------------------------------------------------------ */

.sdk-setup__footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    padding: 8px 20px;
    border-top-width: 1px;
    border-color: rgba(128, 128, 128, 0.3);
}

.sdk-setup__footer .sdk-setup__hint {
    margin-top: 0;
}

.sdk-setup__startup {
    margin: 0;
}
